<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colour palette (from the UI components sheet) -->
    <Color x:Key="BgColor">#2A1A0F</Color>
    <Color x:Key="SurfaceColor">#3A2617</Color>
    <Color x:Key="OutlineColor">#5C4028</Color>
    <Color x:Key="ChocolateColor">#2A1309</Color>
    <Color x:Key="GoldColor">#D4AF6B</Color>
    <Color x:Key="GoldDarkColor">#B8923F</Color>
    <Color x:Key="GoldLightColor">#EAD199</Color>
    <Color x:Key="CreamColor">#F8F1E6</Color>
    <Color x:Key="OffWhiteColor">#FEFBF6</Color>
    <Color x:Key="TextMutedColor">#D9C9AE</Color>
    <Color x:Key="ErrorColor">#F2A9A0</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource OutlineColor}" />
    <SolidColorBrush x:Key="ChocolateBrush" Color="{StaticResource ChocolateColor}" />
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}" />
    <SolidColorBrush x:Key="GoldDarkBrush" Color="{StaticResource GoldDarkColor}" />
    <SolidColorBrush x:Key="GoldLightBrush" Color="{StaticResource GoldLightColor}" />
    <SolidColorBrush x:Key="CreamBrush" Color="{StaticResource CreamColor}" />
    <SolidColorBrush x:Key="OffWhiteBrush" Color="{StaticResource OffWhiteColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource CreamColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="FieldTextBrush" Color="#3A2617" />
    <SolidColorBrush x:Key="FieldHintBrush" Color="#8A7A66" />
    <SolidColorBrush x:Key="FieldIconBrush" Color="#2A1309" />

    <!-- Gold gradient for the primary button, and a brighter one for hover -->
    <LinearGradientBrush x:Key="GoldGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E6C98A" Offset="0" />
        <GradientStop Color="#CFAB68" Offset="0.55" />
        <GradientStop Color="#B8923F" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GoldGradientHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F0D69C" Offset="0" />
        <GradientStop Color="#D9B673" Offset="0.55" />
        <GradientStop Color="#C49C48" Offset="1" />
    </LinearGradientBrush>
    <!-- Gold text with a slight sheen, for the headline -->
    <LinearGradientBrush x:Key="GoldTextBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EBD5A0" Offset="0" />
        <GradientStop Color="#D4AF6B" Offset="0.55" />
        <GradientStop Color="#B8923F" Offset="1" />
    </LinearGradientBrush>
    <!-- Darkens the right side of the hero photo so the form stays readable -->
    <LinearGradientBrush x:Key="HeroScrimBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1A2A1A0F" Offset="0" />
        <GradientStop Color="#002A1A0F" Offset="0.3" />
        <GradientStop Color="#662A1A0F" Offset="0.62" />
        <GradientStop Color="#C42A1A0F" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroBottomScrimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#332A1A0F" Offset="0" />
        <GradientStop Color="#002A1A0F" Offset="0.2" />
        <GradientStop Color="#002A1A0F" Offset="0.75" />
        <GradientStop Color="#992A1A0F" Offset="1" />
    </LinearGradientBrush>

    <!-- Type: Playfair Display (serif display), Allura (script accent), Lora (body); bundled in Assets/Fonts -->
    <FontFamily x:Key="SerifFont">pack://application:,,,/Assets/Fonts/#Playfair Display</FontFamily>
    <FontFamily x:Key="ScriptFont">pack://application:,,,/Assets/Fonts/#Allura</FontFamily>
    <FontFamily x:Key="BodyFont">pack://application:,,,/Assets/Fonts/#Lora</FontFamily>

    <!-- Icons (Material outline paths) -->
    <Geometry x:Key="IconUser">M12,6c1.1,0 2,0.9 2,2s-0.9,2 -2,2s-2,-0.9 -2,-2S10.9,6 12,6M12,15c2.7,0 5.8,1.29 6,2H6c0.23,-0.72 3.31,-2 6,-2M12,4C9.79,4 8,5.79 8,8s1.79,4 4,4s4,-1.79 4,-4S14.21,4 12,4zM12,13c-2.67,0 -8,1.34 -8,4v2h16v-2C20,14.34 14.67,13 12,13z</Geometry>
    <Geometry x:Key="IconMail">M22,6c0,-1.1 -0.9,-2 -2,-2H4C2.9,4 2,4.9 2,6v12c0,1.1 0.9,2 2,2h16c1.1,0 2,-0.9 2,-2V6zM20,6l-8,5L4,6h16zM20,18H4V8l8,5l8,-5V18z</Geometry>
    <Geometry x:Key="IconMenu">M3,6h18v2H3zM3,11h18v2H3zM3,16h18v2H3z</Geometry>

    <!-- Micro-tagline text (letter-spaced small caps) -->
    <Style x:Key="MicroTagline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- Short gold rule under the taglines -->
    <Style x:Key="TaglineRule" TargetType="Rectangle">
        <Setter Property="Height" Value="1.5" />
        <Setter Property="Width" Value="56" />
        <Setter Property="Fill" Value="{StaticResource GoldBrush}" />
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <!-- Base focus visual: a thin gold ring -->
    <Style x:Key="GoldFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{StaticResource GoldLightBrush}" BorderThickness="2" CornerRadius="14" Margin="-3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SUBSCRIBE: gold gradient, 56 high, radius 12, all caps with 2px tracking -->
    <Style x:Key="GoldButton" TargetType="Button">
        <Setter Property="Height" Value="56" />
        <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Foreground" Value="{StaticResource ChocolateBrush}" />
        <Setter Property="Background" Value="{StaticResource GoldGradientBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GoldFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Shadow" Background="#40000000" CornerRadius="12" Margin="2,6,2,-4" Opacity="0.6" />
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="#66FFF2CC" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource GoldGradientHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource GoldDarkBrush}" />
                            <Setter TargetName="Shadow" Property="Opacity" Value="0.2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Outline button (dialogs, "Cancel", "Later") -->
    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource GoldLightBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GoldFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#22D4AF6B" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#44D4AF6B" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}" />

    <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
        <Setter Property="Foreground" Value="{StaticResource ChocolateBrush}" />
        <Setter Property="Background" Value="{StaticResource GoldGradientBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource GoldGradientHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource GoldLightBrush}" />
                            <Setter TargetName="Bg" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource GoldDarkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Row-shaped button for item lists in dialogs (the menu) -->
    <Style x:Key="ListRowButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="MinWidth" Value="300" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- Round icon button (the hamburger menu) -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="22" BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#22D4AF6B" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#44D4AF6B" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The text part of a form field (the off-white box, icon and hint are drawn around it) -->
    <Style x:Key="FieldInput" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource FieldTextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource FieldTextBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource GoldBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The off-white field box: 56 high, radius 12, gold ring when focused -->
    <Style x:Key="FieldBox" TargetType="Border">
        <Setter Property="Height" Value="56" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{StaticResource OffWhiteBrush}" />
        <Setter Property="BorderBrush" Value="#33B8923F" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Thin gold progress bar for the update dialogs -->
    <Style x:Key="ThinProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Maximum" Value="1000" />
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
        <Setter Property="Background" Value="{StaticResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="TemplateRoot">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left" />
                        <Border x:Name="Glow" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left" Width="60" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Glow" Property="Opacity" Value="1" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <ThicknessAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Margin" From="-60,0,0,0" To="600,0,0,0" Duration="0:0:1.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
