<Window x:Class="TheChocolateRabbit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:TheChocolateRabbit.UI"
        Title="The Chocolate Rabbit — Join Our Newsletter"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BgBrush}"
        Width="1280" Height="900" MinWidth="880" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource BodyFont}"
        Foreground="{StaticResource TextBrush}">
    <Grid x:Name="Root">

        <!-- Hero: the chocolate bunny photo fills the window; the scrims keep the form legible -->
        <Image x:Name="Hero" Source="pack://application:,,,/Assets/hero_bg.jpg" Stretch="UniformToFill"
               HorizontalAlignment="Left" VerticalAlignment="Center" />
        <Rectangle Fill="{StaticResource HeroScrimBrush}" />
        <Rectangle Fill="{StaticResource HeroBottomScrimBrush}" />

        <Grid x:Name="Page" Margin="40,32,40,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HeroCol" Width="*" />
                <ColumnDefinition x:Name="FormCol" Width="540" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Logo, top left -->
            <Image x:Name="Logo" Grid.Row="0" Grid.Column="0" Source="pack://application:,,,/Assets/logo_gold.png"
                   Width="190" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,8"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <!-- Tagline + menu, top right -->
            <StackPanel x:Name="TopRight" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0">
                <TextBlock ui:Ui.SpacedText="A SWEETER WORLD" FontFamily="{StaticResource SerifFont}" FontSize="13"
                           Foreground="{StaticResource GoldLightBrush}" VerticalAlignment="Center" Margin="0,0,26,0" />
                <Button x:Name="MenuButton" Style="{StaticResource IconButton}" ToolTip="Menu" Click="Menu_Click" AutomationProperties.Name="Menu">
                    <Path Data="{StaticResource IconMenu}" Fill="{StaticResource GoldLightBrush}" Width="26" Height="26" Stretch="Uniform" />
                </Button>
            </StackPanel>

            <!-- The sign-up form -->
            <ScrollViewer x:Name="FormScroller" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0" Margin="0,8,0,8">
                <StackPanel x:Name="Form" Width="480">
                    <TextBlock x:Name="JoinText" Text="Join Our" FontFamily="{StaticResource ScriptFont}" FontSize="76"
                               Foreground="{StaticResource GoldBrush}" TextAlignment="Center" Margin="0,0,0,-30" />
                    <TextBlock x:Name="NewsletterText" Text="Newsletter" FontFamily="{StaticResource SerifFont}" FontSize="104"
                               Foreground="{StaticResource GoldTextBrush}" TextAlignment="Center" Margin="0,0,0,0" />
                    <Rectangle Height="1" Width="160" Fill="{StaticResource GoldBrush}" Opacity="0.55" Margin="0,-4,0,22" />
                    <TextBlock x:Name="BodyText" TextAlignment="Center" TextWrapping="Wrap" FontFamily="{StaticResource BodyFont}"
                               FontSize="19" LineHeight="30" Foreground="{StaticResource CreamBrush}" Margin="8,0,8,30"
                               Text="Be the first to hear about new chocolates, seasonal collections, exclusive offers and sweet stories from our world." />

                    <!-- Your name -->
                    <Border Style="{StaticResource FieldBox}">
                        <Grid Margin="20,0,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconUser}" Fill="{StaticResource FieldIconBrush}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBlock x:Name="NameHint" Grid.Column="1" Text="Your name" Foreground="{StaticResource FieldHintBrush}" FontSize="16" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <TextBox x:Name="NameBox" Grid.Column="1" Style="{StaticResource FieldInput}" MaxLength="120" TextChanged="Field_TextChanged" KeyDown="Field_KeyDown"
                                     AutomationProperties.Name="Your name" />
                        </Grid>
                    </Border>

                    <!-- Your email -->
                    <Border Style="{StaticResource FieldBox}">
                        <Grid Margin="20,0,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconMail}" Fill="{StaticResource FieldIconBrush}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBlock x:Name="EmailHint" Grid.Column="1" Text="Your email" Foreground="{StaticResource FieldHintBrush}" FontSize="16" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <TextBox x:Name="EmailBox" Grid.Column="1" Style="{StaticResource FieldInput}" MaxLength="254" TextChanged="Field_TextChanged" KeyDown="Field_KeyDown"
                                     AutomationProperties.Name="Your email" />
                        </Grid>
                    </Border>

                    <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="{StaticResource ErrorBrush}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" Margin="0,-6,0,12" />

                    <Button x:Name="SubscribeButton" Style="{StaticResource GoldButton}" Click="Subscribe_Click" Margin="0,4,0,0" AutomationProperties.Name="Subscribe">
                        <TextBlock ui:Ui.SpacedText="SUBSCRIBE" />
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom-left tagline -->
            <StackPanel x:Name="BottomLeft" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <TextBlock Style="{StaticResource MicroTagline}" ui:Ui.SpacedText="MORE" />
                <TextBlock Style="{StaticResource MicroTagline}" ui:Ui.SpacedText="THAN" />
                <TextBlock Style="{StaticResource MicroTagline}" ui:Ui.SpacedText="CHOCOLATE" />
                <Rectangle Style="{StaticResource TaglineRule}" HorizontalAlignment="Left" Margin="0,8,0,0" />
            </StackPanel>

            <!-- Bottom-right tagline -->
            <StackPanel x:Name="BottomRight" Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Rectangle Style="{StaticResource TaglineRule}" VerticalAlignment="Center" Margin="0,0,22,0" />
                <StackPanel>
                    <TextBlock Style="{StaticResource MicroTagline}" ui:Ui.SpacedText="SWEETER" TextAlignment="Right" />
                    <TextBlock Style="{StaticResource MicroTagline}" ui:Ui.SpacedText="TOGETHER" TextAlignment="Right" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border x:Name="ToastBox" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,40" Background="#F03A2617" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1"
                CornerRadius="10" Padding="18,10" MaxWidth="640" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Foreground="{StaticResource TextBrush}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" />
        </Border>
    </Grid>
</Window>
