<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_nav_bar"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout android:id="@+id/navHome" style="@style/NavItem">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_home" app:tint="@color/nav_item_tint"  android:duplicateParentState="true" />
        <TextView style="@style/NavLabel" android:text="@string/nav_home" android:duplicateParentState="true" />
        <View android:id="@+id/navHomeIndicator" android:layout_width="40dp" android:layout_height="3dp" android:layout_marginTop="4dp" android:background="@drawable/hero_accent_bar" />
    </LinearLayout>

    <LinearLayout android:id="@+id/navSearch" style="@style/NavItem">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_search" app:tint="@color/nav_item_tint"  android:duplicateParentState="true" />
        <TextView style="@style/NavLabel" android:text="@string/nav_search" android:duplicateParentState="true" />
        <View android:layout_width="40dp" android:layout_height="3dp" android:layout_marginTop="4dp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/navDownloads" style="@style/NavItem">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_download" app:tint="@color/nav_item_tint"  android:duplicateParentState="true" />
        <TextView style="@style/NavLabel" android:text="@string/nav_downloads" android:duplicateParentState="true" />
        <View android:layout_width="40dp" android:layout_height="3dp" android:layout_marginTop="4dp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/navProfile" style="@style/NavItem">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_person" app:tint="@color/nav_item_tint"  android:duplicateParentState="true" />
        <TextView style="@style/NavLabel" android:text="@string/nav_profile" android:duplicateParentState="true" />
        <View android:layout_width="40dp" android:layout_height="3dp" android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>
