<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_hero" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_scrim" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <include
            android:id="@+id/header"
            layout="@layout/view_home_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtHeroTitle"
            style="@style/HeroTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/hero_title"
            android:textSize="38sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header" />

        <TextView
            android:id="@+id/txtHeroSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/hero_subtitle"
            android:textColor="#E2E8F0"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtHeroTitle" />

        <View
            android:id="@+id/heroBar"
            android:layout_width="72dp"
            android:layout_height="4dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/hero_accent_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtHeroSubtitle" />

        <LinearLayout
            android:id="@+id/dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/heroBar">
            <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/dot_active" />
            <View android:layout_width="10dp" android:layout_height="10dp" android:layout_marginStart="8dp" android:background="@drawable/dot_inactive" />
            <View android:layout_width="10dp" android:layout_height="10dp" android:layout_marginStart="8dp" android:background="@drawable/dot_inactive" />
            <View android:layout_width="10dp" android:layout_height="10dp" android:layout_marginStart="8dp" android:background="@drawable/dot_inactive" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtHeroCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:letterSpacing="0.2"
            android:text="@string/hero_caption_phone"
            android:textColor="#CBD5E1"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/dots"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/cards"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="20dp"
            android:clipChildren="false"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@id/navBar"
            app:layout_constraintHeight_max="360dp"
            app:layout_constraintTop_toBottomOf="@id/dots"
            app:layout_constraintVertical_bias="0">

            <!-- Live TV card -->
            <LinearLayout
                android:id="@+id/btnLive"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_live"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="26dp"
                android:paddingEnd="12dp"
                android:paddingBottom="22dp">

                <ImageView
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_tv_play" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/live_tv"
                    android:textColor="@color/text"
                    android:textSize="21sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="@string/live_tv_subtitle"
                    android:textColor="#BFDBFE"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtLiveStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/not_signed_in"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_chevron_live"
                    android:contentDescription="@null"
                    android:padding="16dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#5EE7FF" />
            </LinearLayout>

            <!-- Video on Demand card -->
            <LinearLayout
                android:id="@+id/btnVod"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_vod"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="26dp"
                android:paddingEnd="12dp"
                android:paddingBottom="22dp">

                <ImageView
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_film_reel" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/video_on_demand"
                    android:textColor="@color/text"
                    android:textSize="21sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="@string/vod_subtitle"
                    android:textColor="#DDD6FE"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtVodStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/not_signed_in"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_chevron_vod"
                    android:contentDescription="@null"
                    android:padding="16dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#C084FC" />
            </LinearLayout>
        </LinearLayout>

        <include
            android:id="@+id/navBar"
            layout="@layout/view_nav_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/txtVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#64748B"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
