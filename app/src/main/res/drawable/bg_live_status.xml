<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><corners android:radius="14dp" /><solid android:color="#F8FAFC" /><stroke android:width="2dp" android:color="#F8FAFC" /></shape>
    </item>
    <!-- Behind live: amber so the "jump to live" hint stands out -->
    <item android:state_selected="true">
        <shape android:shape="rectangle"><corners android:radius="14dp" /><solid android:color="#CC92400E" /><stroke android:width="1dp" android:color="#F59E0B" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><corners android:radius="14dp" /><solid android:color="#CC7F1D1D" /><stroke android:width="1dp" android:color="#F87171" /></shape>
    </item>
</selector>
