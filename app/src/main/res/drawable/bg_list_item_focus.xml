<?xml version="1.0" encoding="utf-8"?>
<!-- Rows inside dialogs (single / multi choice lists): a clear ring when the remote lands on one -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><corners android:radius="8dp" /><solid android:color="#2A5399" /><stroke android:width="2dp" android:color="#FFFFFF" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><corners android:radius="8dp" /><solid android:color="#2A5399" /></shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle"><corners android:radius="8dp" /><solid android:color="#1F3F73" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#00000000" /></shape>
    </item>
</selector>
