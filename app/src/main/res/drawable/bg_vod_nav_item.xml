<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><corners android:radius="14dp" /><solid android:color="#F8FAFC" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><corners android:radius="14dp" /><solid android:color="#33FFFFFF" /></shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle"><corners android:radius="14dp" /><solid android:color="#332B4C8A" /><stroke android:width="1dp" android:color="#7C3AED" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><corners android:radius="14dp" /><solid android:color="#00000000" /></shape>
    </item>
</selector>
