<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><corners android:radius="20dp" /><solid android:color="#14FFFFFF" /><stroke android:width="3dp" android:color="#F8FAFC" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><corners android:radius="20dp" /><solid android:color="#14FFFFFF" /><stroke android:width="3dp" android:color="#F8FAFC" /></shape>
    </item>
    <item><color android:color="#00000000" /></item>
</selector>
