<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused (remote / keyboard): solid white so it stands out from everything else -->
    <item android:state_focused="true">
        <shape android:shape="rectangle"><corners android:radius="18dp" /><solid android:color="#F8FAFC" /><stroke android:width="2dp" android:color="#F8FAFC" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><corners android:radius="18dp" /><solid android:color="#F8FAFC" /></shape>
    </item>
    <!-- Selected (the active tab / category): accent fill -->
    <item android:state_selected="true">
        <shape android:shape="rectangle"><corners android:radius="18dp" /><solid android:color="@color/accent" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><corners android:radius="18dp" /><solid android:color="@color/surface" /><stroke android:width="1dp" android:color="@color/outline" /></shape>
    </item>
</selector>
