<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:top="-2dp" android:bottom="-2dp" android:left="-2dp" android:right="-2dp">
                <shape android:shape="rectangle"><corners android:radius="22dp" /><solid android:color="#5522D3EE" /></shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <gradient android:angle="0" android:startColor="#1B4FB8" android:centerColor="#12377F" android:endColor="#0C2456" />
                    <stroke android:width="2dp" android:color="#5EE7FF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient android:angle="0" android:startColor="#1B4FB8" android:centerColor="#12377F" android:endColor="#0C2456" />
            <stroke android:width="2dp" android:color="#5EE7FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient android:angle="0" android:startColor="#16409A" android:centerColor="#0F2D6B" android:endColor="#0B1F4D" />
            <stroke android:width="1.5dp" android:color="#38BDF8" />
        </shape>
    </item>
</selector>
