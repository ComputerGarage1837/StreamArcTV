<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Stream Arc TV for Linux. The screens, data layer, player and transfer engine are shared with
    the macOS edition and live in desktop/Shared; this project adds the Linux specifics
    (Util/Platform.cs) and the packaging (package/make-packages.sh).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>StreamArcTV</RootNamespace>
    <AssemblyName>StreamArcTV</AssemblyName>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Product>Stream Arc TV</Product>
    <Company>Computer Garage</Company>
    <Copyright>MIT</Copyright>
    <AssemblyTitle>Stream Arc TV</AssemblyTitle>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <UseAppHost>true</UseAppHost>
    <SharedDir>$(MSBuildThisFileDirectory)../../desktop/Shared/</SharedDir>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="GitHubRepo" Value="$(GitHubRepo)" />
    <AssemblyMetadata Include="LiveUrl" Value="$(LiveUrl)" />
    <AssemblyMetadata Include="VodUrl" Value="$(VodUrl)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="11.3.22" />
    <PackageReference Include="LibVLCSharp" Version="3.10.1" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.10.1" />
  </ItemGroup>

  <!-- Shared desktop sources (see desktop/Shared). -->
  <ItemGroup>
    <Compile Include="$(SharedDir)**/*.cs" Link="Shared/%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaXaml Include="$(SharedDir)**/*.axaml" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Include="$(SharedDir)Assets/**/*.png;$(SharedDir)Assets/**/*.jpg" Link="Assets/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
