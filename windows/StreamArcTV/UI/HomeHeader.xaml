<UserControl x:Class="StreamArcTV.UI.HomeHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image x:Name="ImgLogo" Source="pack://application:,,,/Assets/ic_logo_mark.png" Width="46" Height="46" Stretch="Uniform" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="TxtBrand" FontSize="22" FontWeight="Black" Foreground="{StaticResource TextBrush}" />
            <TextBlock Text="Good Entertainment Lives Here" FontSize="12" Foreground="#94A3B8" />
        </StackPanel>
        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="BtnUpdate" Style="{StaticResource RoundImageButton}" Width="44" Height="44" ToolTip="Update">
                <Image Source="pack://application:,,,/Assets/img_btn_update.png" Stretch="Uniform" />
            </Button>
            <TextBlock Text="Update" FontSize="11" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0,0,0">
            <Button x:Name="BtnSettings" Style="{StaticResource RoundImageButton}" Width="44" Height="44" ToolTip="Settings">
                <Image Source="pack://application:,,,/Assets/img_btn_settings.png" Stretch="Uniform" />
            </Button>
            <TextBlock Text="Settings" FontSize="11" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
        </StackPanel>
        <TextBlock x:Name="TxtClock" Grid.Column="4" Margin="20,0,0,0" FontSize="15" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
    </Grid>
</UserControl>
