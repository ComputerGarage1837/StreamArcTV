<ui:AppPage x:Class="StreamArcTV.UI.MultiViewPage"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:ui="clr-namespace:StreamArcTV.UI"
            Background="#000000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Background="{StaticResource BgBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnBack" Style="{StaticResource SquareIconButton}" Width="40" Height="40" Margin="8,4,0,4" ToolTip="Back">
                <Path Data="{StaticResource IconBack}" Fill="{StaticResource TextBrush}" Width="20" Height="20" Stretch="Uniform" />
            </Button>
            <TextBlock Grid.Column="1" Text="Multi-view" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
            <TextBlock Grid.Column="2" Text="Enter: choose channel · hold Enter / right-click: full screen, remove · sound follows the highlighted tile" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" />
            <Button x:Name="BtnTiles" Grid.Column="3" Content="2 × 2" Style="{StaticResource SmallButton}" Margin="0,4,8,4" />
        </Grid>
        <UniformGrid x:Name="Tiles" Grid.Row="1" Columns="2" />
    </Grid>
</ui:AppPage>
