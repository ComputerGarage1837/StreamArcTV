<ui:AppPage x:Class="StreamArcTV.UI.ProfilePage"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:ui="clr-namespace:StreamArcTV.UI"
            Background="{StaticResource HomeGradientBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid Margin="20">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnBack" Style="{StaticResource SquareIconButton}" ToolTip="Back">
                    <Path Data="{StaticResource IconBack}" Fill="{StaticResource TextBrush}" Width="22" Height="22" Stretch="Uniform" />
                </Button>
                <TextBlock x:Name="TxtTitle" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20" Margin="0,20,0,0" MaxWidth="560" HorizontalAlignment="Center" MinWidth="420">
                <StackPanel>
                    <Image Source="pack://application:,,,/Assets/ic_logo_mark.png" Width="72" Height="72" Stretch="Uniform" />
                    <TextBlock x:Name="TxtUsername" FontSize="22" Foreground="{StaticResource TextBrush}" TextAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock x:Name="TxtServer" FontSize="13" Foreground="{StaticResource AccentBrush}" TextAlignment="Center" Margin="0,0,0,12" />
                    <Grid x:Name="Rows">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Status" FontSize="15" Foreground="{StaticResource TextMutedBrush}" Margin="0,10" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtStatus" FontSize="15" Foreground="{StaticResource TextBrush}" Margin="0,10" />
                        <TextBlock Grid.Row="1" Text="Expires" FontSize="15" Foreground="{StaticResource TextMutedBrush}" Margin="0,10" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtExpiry" FontSize="15" Foreground="{StaticResource TextBrush}" Margin="0,10" />
                        <TextBlock Grid.Row="2" Text="Connections" FontSize="15" Foreground="{StaticResource TextMutedBrush}" Margin="0,10" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtConnections" FontSize="15" Foreground="{StaticResource TextBrush}" Margin="0,10" />
                        <TextBlock Grid.Row="3" Text="Created" FontSize="15" Foreground="{StaticResource TextMutedBrush}" Margin="0,10" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtCreated" FontSize="15" Foreground="{StaticResource TextBrush}" Margin="0,10" />
                        <TextBlock Grid.Row="4" Text="Trial" FontSize="15" Foreground="{StaticResource TextMutedBrush}" Margin="0,10" />
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtTrial" FontSize="15" Foreground="{StaticResource TextBrush}" Margin="0,10" />
                    </Grid>
                    <Button x:Name="BtnLogout" Content="Log out" Style="{StaticResource PrimaryButton}" Margin="0,20,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</ui:AppPage>
