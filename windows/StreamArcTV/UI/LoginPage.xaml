<ui:AppPage x:Class="StreamArcTV.UI.LoginPage"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:ui="clr-namespace:StreamArcTV.UI"
            Background="{StaticResource HomeGradientBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="24" HorizontalAlignment="Center">
            <Image Source="pack://application:,,,/Assets/logo_wordmark.png" Width="260" Height="80" Stretch="Uniform" Margin="0,12,0,0" />
            <Border Style="{StaticResource Card}" Width="480" Padding="24" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock x:Name="TxtTitle" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="Server" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" />
                    <TextBlock x:Name="TxtServer" FontSize="14" Foreground="{StaticResource AccentBrush}" />
                    <TextBox x:Name="InputUsername" Style="{StaticResource InputBox}" Tag="Username" Margin="0,20,0,0" />
                    <Grid Margin="0,12,0,0">
                        <PasswordBox x:Name="InputPassword" Style="{StaticResource PasswordInput}" />
                        <TextBlock x:Name="PasswordHint" Text="Password" Foreground="{StaticResource TextMutedBrush}" FontSize="15" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" />
                    </Grid>
                    <TextBlock x:Name="TxtError" Foreground="{StaticResource DangerBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
                    <Control x:Name="Progress" Style="{StaticResource Spinner}" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed" />
                    <Button x:Name="BtnSignIn" Content="Sign in" Style="{StaticResource PrimaryButton}" Margin="0,20,0,0" />
                    <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ui:AppPage>
