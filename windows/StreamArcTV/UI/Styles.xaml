<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:StreamArcTV.UI">

    <!-- Colors (same palette as the Android app's colors.xml) -->
    <Color x:Key="BgColor">#0A1628</Color>
    <Color x:Key="BgGradientEndColor">#0F2140</Color>
    <Color x:Key="SurfaceColor">#132A4F</Color>
    <Color x:Key="SurfaceFocusedColor">#1B3A6B</Color>
    <Color x:Key="OutlineColor">#1E3A5F</Color>
    <Color x:Key="AccentColor">#22D3EE</Color>
    <Color x:Key="AccentDarkColor">#7C3AED</Color>
    <Color x:Key="TextColor">#F8FAFC</Color>
    <Color x:Key="TextMutedColor">#94A3B8</Color>
    <Color x:Key="DangerColor">#F87171</Color>
    <Color x:Key="PurpleColor">#A78BFA</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceFocusedBrush" Color="{StaticResource SurfaceFocusedColor}" />
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource OutlineColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}" />
    <SolidColorBrush x:Key="InputBgBrush" Color="#0D1F3C" />
    <SolidColorBrush x:Key="PanelBrush" Color="#0F2140" />
    <SolidColorBrush x:Key="WhiteBrush" Color="#F8FAFC" />

    <LinearGradientBrush x:Key="HomeGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0A1628" Offset="0" />
        <GradientStop Color="#0F2140" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroScrimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#260A1628" Offset="0.5" />
        <GradientStop Color="#CC0A1628" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroAccentBarBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#A855F7" Offset="0" />
        <GradientStop Color="#3B82F6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="VodHeroScrimHBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E60A1628" Offset="0" />
        <GradientStop Color="#800A1628" Offset="0.5" />
        <GradientStop Color="#1A0A1628" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="VodHeroScrimVBrush" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Color="#F00A1628" Offset="0" />
        <GradientStop Color="#330A1628" Offset="0.5" />
        <GradientStop Color="#000A1628" Offset="1" />
    </LinearGradientBrush>

    <!-- Icons (paths from the Android vector drawables) -->
    <Geometry x:Key="IconBack">M20,11H7.83l5.59,-5.59L12,4l-8,8l8,8l1.41,-1.41L7.83,13H20V11z</Geometry>
    <Geometry x:Key="IconProfile">M12,12c2.21,0 4,-1.79 4,-4s-1.79,-4 -4,-4s-4,1.79 -4,4S9.79,12 12,12zM12,14c-2.67,0 -8,1.34 -8,4v2h16v-2C20,15.34 14.67,14 12,14z</Geometry>
    <Geometry x:Key="IconMulti">M3,4h8v7H3zM13,4h8v7h-8zM3,13h8v7H3zM13,13h8v7h-8z</Geometry>
    <Geometry x:Key="IconVod">M18,4l2,4h-3l-2,-4h-2l2,4h-3l-2,-4H8l2,4H7L5,4H4C2.9,4 2,4.9 2,6v12c0,1.1 0.9,2 2,2h16c1.1,0 2,-0.9 2,-2V4H18zM10,17v-6l5,3L10,17z</Geometry>
    <Geometry x:Key="IconUpdate">M12,4V1L8,5l4,4V6c3.31,0 6,2.69 6,6c0,1.01 -0.25,1.97 -0.7,2.8l1.46,1.46C19.54,15.03 20,13.57 20,12C20,7.58 16.42,4 12,4zM12,18c-3.31,0 -6,-2.69 -6,-6c0,-1.01 0.25,-1.97 0.7,-2.8L5.24,7.74C4.46,8.97 4,10.43 4,12c0,4.42 3.58,8 8,8v3l4,-4l-4,-4V18z</Geometry>
    <Geometry x:Key="IconLive">M21,3H3C1.9,3 1,3.9 1,5v12c0,1.1 0.9,2 2,2h5v2h8v-2h5c1.1,0 2,-0.9 2,-2V5C23,3.9 22.1,3 21,3zM21,17H3V5h18V17zM10,7v8l5,-4L10,7z</Geometry>
    <Geometry x:Key="IconRecRing">M12,3 A9,9 0 1 0 12.01,3 Z</Geometry>
    <Geometry x:Key="IconRecDot">M12,7.5 A4.5,4.5 0 1 0 12.01,7.5 Z</Geometry>
    <Geometry x:Key="IconPlay">M8,5v14l11,-7z</Geometry>
    <Geometry x:Key="IconPause">M6,19h4V5H6v14zM14,5v14h4V5h-4z</Geometry>
    <Geometry x:Key="IconCc">M19,4H5C3.89,4 3,4.9 3,6v12c0,1.1 0.89,2 2,2h14c1.1,0 2,-0.9 2,-2V6C21,4.9 20.1,4 19,4zM19,18H5V6h14V18zM11,10H9.5v-0.5h-2v3h2V12H11v1c0,0.55 -0.45,1 -1,1H7c-0.55,0 -1,-0.45 -1,-1v-4c0,-0.55 0.45,-1 1,-1h3c0.55,0 1,0.45 1,1V10zM18,10h-1.5v-0.5h-2v3h2V12H18v1c0,0.55 -0.45,1 -1,1h-3c-0.55,0 -1,-0.45 -1,-1v-4c0,-0.55 0.45,-1 1,-1h3c0.55,0 1,0.45 1,1V10z</Geometry>
    <Geometry x:Key="IconFullscreen">M7,14H5v5h5v-2H7v-3zM5,10h2V7h3V5H5v5zM17,17h-3v2h5v-5h-2v3zM14,5v2h3v3h2V5h-5z</Geometry>

    <DrawingImage x:Key="PlaceholderImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#0D1F3C" Geometry="M0,0h96v96h-96z" />
                <GeometryDrawing Brush="#3B5A85" Geometry="M69,27H27c-2.2,0 -4,1.8 -4,4v24c0,2.2 1.8,4 4,4h10v4h22v-4h10c2.2,0 4,-1.8 4,-4V31C73,28.8 71.2,27 69,27zM69,55H27V31h42V55zM44,35v16l10,-8L44,35z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Text -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
        <Setter Property="Margin" Value="0,20,0,8" />
    </Style>

    <!-- Base button template: rounded, no chrome -->
    <ControlTemplate x:Key="RoundedButtonTemplate" TargetType="ButtonBase">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="False" TextElement.Foreground="{TemplateBinding Foreground}" />
        </Border>
    </ControlTemplate>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
        <Setter Property="Tag"><Setter.Value><CornerRadius>12</CornerRadius></Setter.Value></Setter>
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="20,6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="#7DF5E5" />
                <Setter Property="BorderBrush" Value="#FFFFFF" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#7DF5E5" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#22C55E" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#3A5EEAD4" />
                <Setter Property="Foreground" Value="#80F8FAFC" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#FCA5A5" /><Setter Property="BorderBrush" Value="#FFFFFF" /></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FCA5A5" /></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
        <Setter Property="Tag"><Setter.Value><CornerRadius>12</CornerRadius></Setter.Value></Setter>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="16,4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceFocusedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceFocusedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <Trigger Property="ui:Ui.Selected" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceFocusedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SquareIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,2" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceFocusedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceFocusedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
            <Trigger Property="ui:Ui.Selected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TabButton" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
        <Setter Property="Tag"><Setter.Value><CornerRadius>18</CornerRadius></Setter.Value></Setter>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="16,2" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <!-- Selected (the active tab / category): accent fill -->
            <Trigger Property="ui:Ui.Selected" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <!-- Focused (keyboard): solid white so it stands out from everything else -->
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{StaticResource WhiteBrush}" />
                <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource WhiteBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource WhiteBrush}" />
                <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Buttons inside dialogs -->
    <Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- Row-shaped button for item lists in dialogs -->
    <Style x:Key="ListRowButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- Settings rows: clickable full-width rows -->
    <Style x:Key="SettingsRow" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Tag"><Setter.Value><CornerRadius>14</CornerRadius></Setter.Value></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="FontSize" Value="15.5" />
        <Setter Property="MinHeight" Value="52" />
    </Style>

    <!-- Static panel look (bg_panel / bg_row) -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <!-- FocusCard templates: stream items (posters, rows), category rows, chips, nav items, tiles -->
    <ControlTemplate x:Key="FocusCardTemplate" TargetType="ui:FocusCard">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
    </ControlTemplate>

    <Style x:Key="StreamItem" TargetType="ui:FocusCard">
        <Setter Property="Template" Value="{StaticResource FocusCardTemplate}" />
        <Setter Property="Tag"><Setter.Value><CornerRadius>12</CornerRadius></Setter.Value></Setter>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="Selected" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceFocusedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceFocusedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceFocusedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="3" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CategoryItem" TargetType="ui:FocusCard">
        <Setter Property="Template" Value="{StaticResource FocusCardTemplate}" />
        <Setter Property="Tag"><Setter.Value><CornerRadius>10</CornerRadius></Setter.Value></Setter>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,10,8,10" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="Selected" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceFocusedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceFocusedBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceFocusedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ChipItem" TargetType="ui:FocusCard">
        <Setter Property="Template" Value="{StaticResource FocusCardTemplate}" />
        <Setter Property="Tag"><Setter.Value><CornerRadius>18</CornerRadius></Setter.Value></Setter>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="Selected" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{StaticResource WhiteBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource WhiteBrush}" />
                <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource WhiteBrush}" />
                <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Home bottom bar items -->
    <Style x:Key="NavItem" TargetType="ui:FocusCard">
        <Setter Property="Template" Value="{StaticResource FocusCardTemplate}" />
        <Setter Property="Tag"><Setter.Value><CornerRadius>16</CornerRadius></Setter.Value></Setter>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,8,8,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#26FFFFFF" /></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#26FFFFFF" /></Trigger>
        </Style.Triggers>
    </Style>

    <!-- VOD home side-rail items -->
    <Style x:Key="VodNavItem" TargetType="ui:FocusCard">
        <Setter Property="Template" Value="{StaticResource FocusCardTemplate}" />
        <Setter Property="Tag"><Setter.Value><CornerRadius>14</CornerRadius></Setter.Value></Setter>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,10,6,8" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="Selected" Value="True">
                <Setter Property="Background" Value="#332B4C8A" />
                <Setter Property="BorderBrush" Value="#7C3AED" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#33FFFFFF" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{StaticResource WhiteBrush}" />
                <Setter Property="TextElement.Foreground" Value="{StaticResource BgBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Home big cards: transparent with a white focus ring -->
    <Style x:Key="HomeCard" TargetType="ui:FocusCard">
        <Setter Property="Template" Value="{StaticResource FocusCardTemplate}" />
        <Setter Property="Tag"><Setter.Value><CornerRadius>20</CornerRadius></Setter.Value></Setter>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="#14FFFFFF" />
                <Setter Property="BorderBrush" Value="{StaticResource WhiteBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#14FFFFFF" />
                <Setter Property="BorderBrush" Value="{StaticResource WhiteBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Round header buttons (Update / Settings) -->
    <Style x:Key="RoundImageButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2" />
                        <ContentPresenter Margin="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#1FFFFFFF" /><Setter Property="BorderBrush" Value="{StaticResource WhiteBrush}" /></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1FFFFFFF" /><Setter Property="BorderBrush" Value="{StaticResource WhiteBrush}" /></Trigger>
        </Style.Triggers>
    </Style>

    <!-- Multi-view tile -->
    <Style x:Key="TileCard" TargetType="ui:FocusCard">
        <Setter Property="Template" Value="{StaticResource FocusCardTemplate}" />
        <Setter Property="Tag"><Setter.Value><CornerRadius>0</CornerRadius></Setter.Value></Setter>
        <Setter Property="Background" Value="#000000" />
        <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="Selected" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource WhiteBrush}" /></Trigger>
        </Style.Triggers>
    </Style>

    <!-- Text input -->
    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource InputBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <TextBlock x:Name="Hint" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{StaticResource TextMutedBrush}" FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PasswordInput" TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource InputBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Switch (SwitchCompat look) -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="KeyboardNavigation.AcceptsReturn" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="15.5" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="16,14" MinHeight="52">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Grid Grid.Column="1" Width="44" Height="22" Margin="12,0,0,0" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="11" Background="#3B4B63" />
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#CBD5E1" HorizontalAlignment="Left" Margin="3,0,0,0" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource BgBrush}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceFocusedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceFocusedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Radio and check rows in dialogs -->
    <Style x:Key="DialogRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,9">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid Width="20" Height="20" Margin="0,0,12,0">
                                <Ellipse Stroke="{StaticResource TextMutedBrush}" StrokeThickness="2" />
                                <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{StaticResource AccentBrush}" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Dot" Property="Visibility" Value="Visible" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{StaticResource SurfaceFocusedBrush}" /><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource SurfaceFocusedBrush}" /></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DialogCheck" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,9">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="20" Height="20" Margin="0,0,12,0" CornerRadius="4" BorderBrush="{StaticResource TextMutedBrush}" BorderThickness="2" x:Name="Box">
                                <Path x:Name="Tick" Data="M4,10 L8,14 L16,6" Stroke="{StaticResource BgBrush}" StrokeThickness="2.5" Visibility="Collapsed" Stretch="None" />
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{StaticResource SurfaceFocusedBrush}" /><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource SurfaceFocusedBrush}" /></Trigger>
        </Style.Triggers>
    </Style>

    <!-- Thin progress bar (progress_epg) -->
    <Style x:Key="ThinProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Maximum" Value="1000" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Background" Value="#1E3A5F" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="TemplateRoot">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left" />
                        <Border x:Name="Glow" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left" Width="60" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Glow" Property="Opacity" Value="1" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <ThicknessAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Margin" From="-60,0,0,0" To="600,0,0,0" Duration="0:0:1.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Spinner (circular indeterminate ProgressBar) -->
    <Style x:Key="Spinner" TargetType="Control">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid x:Name="G" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><RotateTransform x:Name="Rot" /></Grid.RenderTransform>
                        <Ellipse Stroke="#334155" StrokeThickness="4" />
                        <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="None"
                              Data="M20,2 A18,18 0 0 1 38,20" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="Rot" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.9" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Scrollbars: slim and dark -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#553B5A85" CornerRadius="4" Margin="1" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="#553B5A85" CornerRadius="4" Margin="1" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Live badge (bg_live_status): red = live, amber = behind live, white = focused -->
    <Style x:Key="LiveBadge" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
        <Setter Property="Tag"><Setter.Value><CornerRadius>14</CornerRadius></Setter.Value></Setter>
        <Setter Property="Background" Value="#CC7F1D1D" />
        <Setter Property="BorderBrush" Value="#F87171" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="ui:Ui.Selected" Value="True">
                <Setter Property="Background" Value="#CC92400E" />
                <Setter Property="BorderBrush" Value="#F59E0B" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{StaticResource WhiteBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource WhiteBrush}" />
                <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Player seek buttons (bg_seek_button) -->
    <Style x:Key="SeekButton" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
        <Setter Property="Tag"><Setter.Value><CornerRadius>24</CornerRadius></Setter.Value></Setter>
        <Setter Property="Background" Value="#B3000000" />
        <Setter Property="BorderBrush" Value="#66FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{StaticResource WhiteBrush}" />
                <Setter Property="Foreground" Value="{StaticResource BgBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#CC000000" /><Setter Property="BorderBrush" Value="#FFFFFF" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource AccentBrush}" /></Trigger>
        </Style.Triggers>
    </Style>

    <!-- Player controller buttons: circular, translucent -->
    <Style x:Key="PlayerButton" TargetType="Button">
        <Setter Property="Background" Value="#22FFFFFF" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.5" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{StaticResource WhiteBrush}" /><Setter Property="Foreground" Value="{StaticResource BgBrush}" /></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#55FFFFFF" /></Trigger>
        </Style.Triggers>
    </Style>

    <!-- Seek slider -->
    <Style x:Key="SeekSlider" TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Height" Value="22" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Border Height="4" CornerRadius="2" Background="#55FFFFFF" VerticalAlignment="Center" />
                        <Border x:Name="Buffered" Height="4" CornerRadius="2" Background="#88FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Left" Width="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton IsTabStop="False" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton IsTabStop="False" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb"><Ellipse Fill="{StaticResource AccentBrush}" /></ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tooltips -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
    </Style>
</ResourceDictionary>
