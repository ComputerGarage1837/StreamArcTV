<Window x:Class="StreamArcTV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stream Arc TV"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BgBrush}"
        Width="1280" Height="720" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        Foreground="{StaticResource TextBrush}">
    <Grid x:Name="Root">
        <Grid x:Name="Host" />
        <Border x:Name="ToastBox" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,48" Background="#E6132A4F" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1"
                CornerRadius="10" Padding="18,10" MaxWidth="640" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Foreground="{StaticResource TextBrush}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" />
        </Border>
    </Grid>
</Window>
