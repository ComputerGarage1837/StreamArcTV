<Project>
  <!--
    Stream Arc TV for Windows: product settings shared by every project in this folder.
    VERSION drives the version code (major*10000 + minor*100 + patch), which must always be higher
    than the versionCode in release/update-windows.json. The server addresses are the same two
    Xtream Codes services as the Android app; override with -p:LiveUrl=... if needed.
  -->
  <PropertyGroup>
    <Version>1.0.5</Version>
    <GitHubRepo Condition="'$(GitHubRepo)' == ''">ComputerGarage1837/StreamArcTV</GitHubRepo>
    <LiveUrl Condition="'$(LiveUrl)' == ''">https://mediahere.ca/</LiveUrl>
    <VodUrl Condition="'$(VodUrl)' == ''">https://onlypuds.fans:2083/</VodUrl>
  </PropertyGroup>
</Project>
