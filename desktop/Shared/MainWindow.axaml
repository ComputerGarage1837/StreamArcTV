<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StreamArcTV.MainWindow"
        Title="Stream Arc TV"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        Width="1280" Height="720" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        XYFocus.NavigationModes="Keyboard">
    <Panel x:Name="Root">
        <Panel x:Name="Host" />
        <Border x:Name="ToastBox" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,48" Background="#E6132A4F" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1"
                CornerRadius="10" Padding="18,10" MaxWidth="640" IsHitTestVisible="False" ZIndex="100">
            <TextBlock x:Name="ToastText" Foreground="{StaticResource TextBrush}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" />
        </Border>
    </Panel>
</Window>
