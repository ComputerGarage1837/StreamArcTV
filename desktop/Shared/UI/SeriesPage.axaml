<ui:AppPage xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:ui="using:StreamArcTV.UI"
            x:Class="StreamArcTV.UI.SeriesPage">
    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Margin="12" ColumnDefinitions="Auto,*,Auto">
            <Button x:Name="BtnBack" Classes="squareicon" ToolTip.Tip="Back">
                <Path Data="{StaticResource IconBack}" Fill="{StaticResource TextBrush}" Width="22" Height="22" Stretch="Uniform" />
            </Button>
            <TextBlock x:Name="TxtTitle" Grid.Column="1" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" />
            <Button x:Name="BtnDownloadAll" Grid.Column="2" Content="Download all" Classes="small" IsVisible="False" />
        </Grid>
        <Grid Grid.Row="1" Margin="16,0,16,0" ColumnDefinitions="Auto,*">
            <Border Width="160" Height="230" Background="{StaticResource PosterBgBrush}" CornerRadius="8" ClipToBounds="True">
                <Image x:Name="ImgCover" Stretch="UniformToFill" />
            </Border>
            <TextBlock x:Name="TxtPlot" Grid.Column="1" Margin="16,0,0,0" FontSize="14" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="7" VerticalAlignment="Top" />
        </Grid>
        <ScrollViewer x:Name="Scroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,12,0,0" Padding="12,0,12,16">
            <StackPanel x:Name="List" />
        </ScrollViewer>
        <ui:Spinner x:Name="Progress" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
        <TextBlock x:Name="TxtError" Grid.Row="2" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" TextWrapping="Wrap" IsVisible="False" />
    </Grid>
</ui:AppPage>
