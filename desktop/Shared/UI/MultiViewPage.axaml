<ui:AppPage xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:ui="using:StreamArcTV.UI"
            x:Class="StreamArcTV.UI.MultiViewPage"
            Background="#000000">
    <Grid RowDefinitions="Auto,*">
        <Grid Background="{StaticResource BgBrush}" ColumnDefinitions="Auto,*,Auto,Auto">
            <Button x:Name="BtnBack" Classes="squareicon" Width="40" Height="40" MinHeight="40" Margin="8,4,0,4" ToolTip.Tip="Back">
                <Path Data="{StaticResource IconBack}" Fill="{StaticResource TextBrush}" Width="20" Height="20" Stretch="Uniform" />
            </Button>
            <TextBlock Grid.Column="1" Text="Multi-view" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
            <TextBlock Grid.Column="2" Text="Enter: choose channel · hold Enter / right-click: full screen, remove · sound follows the highlighted tile" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" />
            <Button x:Name="BtnTiles" Grid.Column="3" Content="2 × 2" Classes="small" Margin="0,4,8,4" />
        </Grid>
        <UniformGrid x:Name="Tiles" Grid.Row="1" Columns="2" />
    </Grid>
</ui:AppPage>
